<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Storyteller principal. O "corpo" que usa os cérebros. -->
  <StorytellerDef ParentName="BaseStoryteller">
    <defName>XenoDirector</defName>
    <label>XenoDirector</label>
    <description>Director omnisciente + múltiplos micro-cérebros. Inspirado no Xenomorfo de Alien: Isolation. Observa reações do jogador e coordena eventos de vários mods como uma narrativa coerente.</description>
    <portraitLarge>UI/HeroArt/Storytellers/CassandraClassic</portraitLarge>
    <portraitTiny>UI/HeroArt/Storytellers/CassandraClassicTiny</portraitTiny>
    <listOrder>50</listOrder>
    <comps>
      <!-- Comp principal do sistema de cérebros -->
      <li Class="XenoDirector.StorytellerCompProperties_XenoDirector">
        <minDaysPassed>0</minDaysPassed>
        <!-- Configuração base de cérebros (pode ser sobrescrita em runtime) -->
        <baseMicroBrainCount>2</baseMicroBrainCount>
        <maxMicroBrainCount>8</maxMicroBrainCount>
        <menaceGaugeDecayPerDay>0.15</menaceGaugeDecayPerDay>
        <playerReactionWindowTicks>15000</playerReactionWindowTicks>
      </li>
      <!-- Comp de ameaça clássica (fallback + integração) -->
      <li Class="StorytellerCompProperties_OnOffCycle">
        <category>ThreatBig</category>
        <minDaysPassed>5</minDaysPassed>
        <onDays>1.5</onDays>
        <offDays>3.5</offDays>
        <numIncidentsRange>1</numIncidentsRange>
        <forceRaidEnemyBeforeDaysPassed>20</forceRaidEnemyBeforeDaysPassed>
      </li>
      <li Class="StorytellerCompProperties_RandomMain">
        <minDaysPassed>0</minDaysPassed>
        <mtbDays>4</mtbDays>
        <maxThreatBigIntervalDays>15</maxThreatBigIntervalDays>
        <categoryWeights>
          <Misc>1</Misc>
        </categoryWeights>
      </li>
    </comps>
  </StorytellerDef>
</Defs>
